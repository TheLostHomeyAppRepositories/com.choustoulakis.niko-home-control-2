{
  "triggers": [
    {
      "id": "jwt_expiring",
      "title": {
        "en": "The token expires within a number of days",
        "nl": "Het token verloopt binnen een aantal dagen"
      },
      "titleFormatted": {
        "en": "The token expires within [[days]] days",
        "nl": "Het token verloopt binnen [[days]] dagen"
      },
      "hint": {
        "en": "Runs once a day while the Hobby API token expires within the given number of days.",
        "nl": "Wordt dagelijks uitgevoerd zolang het Hobby API-token binnen het opgegeven aantal dagen verloopt."
      },
      "tokens": [
        {
          "name": "days",
          "type": "number",
          "title": {
            "en": "Days left",
            "nl": "Resterende dagen"
          },
          "example": 14
        }
      ],
      "args": [
        {
          "name": "days",
          "type": "number",
          "min": 0,
          "max": 365,
          "step": 1,
          "placeholder": {
            "en": "30",
            "nl": "30"
          },
          "title": {
            "en": "Days",
            "nl": "Dagen"
          }
        }
      ]
    }
  ],
  "conditions": [
    {
      "id": "jwt_expires_within",
      "title": {
        "en": "The token !{{expires|doesn't expire}} within a number of days",
        "nl": "Het token !{{verloopt|verloopt niet}} binnen een aantal dagen"
      },
      "titleFormatted": {
        "en": "The token !{{expires|doesn't expire}} within [[days]] days",
        "nl": "Het token !{{verloopt|verloopt niet}} binnen [[days]] dagen"
      },
      "args": [
        {
          "name": "days",
          "type": "number",
          "min": 0,
          "max": 365,
          "step": 1,
          "placeholder": {
            "en": "30",
            "nl": "30"
          },
          "title": {
            "en": "Days",
            "nl": "Dagen"
          }
        }
      ]
    }
  ]
}
